# ==============================================================================
# AWS Credentials for Secret Provisioning
# ==============================================================================
# These credentials are used by setup_env.py to fetch API keys from
# AWS Secrets Manager. They are read-only and scoped to a single secret.
#
# Setup:
#   1. Make sure this file exists and is named .env.local, then fill in
#      the values (provided separately by the project owner).
#   2. Run in terminal:  python setup_env.py
#      The script will fetch the API keys from AWS Secrets Manager and
#      write them to the .env file.
#   3. Run in terminal:  docker compose build
#   4. Run in terminal:  docker compose run agent python main.py
#   5. Run in terminal:  docker compose run agent python main.py --interactive
# ==============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
