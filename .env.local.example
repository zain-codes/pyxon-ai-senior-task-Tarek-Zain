# ==============================================================================
# AWS Credentials for Secret Provisioning
# ==============================================================================
# These credentials are used by setup_env.py to fetch API keys from
# AWS Secrets Manager. They are read-only and scoped to a single secret.
#
# Setup:
#   1. Copy this file:    cp .env.local.example .env.local
#   2. Fill in the values (provided separately by the project owner).
#   3. Run:               python setup_env.py
# ==============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
