# ==============================================================================
# AWS Credentials for Secret Provisioning
# ==============================================================================
# These credentials are used by setup_env.py to fetch API keys from
# AWS Secrets Manager. They are read-only and scoped to a single secret.
#
# Setup:
#   1. Run in terminal:  cp .env.local.example .env.local
#   2. Fill in the values below (provided separately by the project owner).
#   3. Run in terminal:  python setup_env.py
#      The script will fetch the API keys from AWS Secrets Manager and
#      write them to the .env file.
#   4. Run in terminal:  docker compose build
#   5. Run in terminal:  docker compose run agent python main.py
#   6. Run in terminal:  docker compose run agent python main.py --interactive
# ==============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
