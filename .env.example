# ==============================================================================
# Pyxon AI — Environment Configuration Template
# ==============================================================================
# Setup:
#   1. Copy this file:    cp .env.example .env
#   2. Fill in the required values below.
#   3. Never commit .env to version control.
# ==============================================================================

# --- LLM Provider (Groq) ---
# [REQUIRED] Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq-hosted model identifier
MODEL_NAME=llama-3.3-70b-versatile

# --- Search Tool (Tavily) ---
# [REQUIRED] Get your key at https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Maximum number of search results per query (1–20)
SEARCH_MAX_RESULTS=5

# --- URL Fetch Tool ---
# HTTP request timeout in seconds
URL_FETCH_TIMEOUT=10

# Maximum response body size in bytes (default 50 KB)
URL_FETCH_MAX_SIZE=51200

# --- RAG / Embeddings ---
# Enable or disable the RAG vector-store pipeline (true/false)
RAG_ENABLED=true

# HuggingFace sentence-transformers model for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
